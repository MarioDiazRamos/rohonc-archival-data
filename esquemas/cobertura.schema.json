{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "alcance": {
      "enum": [
        "completo",
        "completo_en_segmento",
        "parcial",
        "sin_copia"
      ]
    },
    "fecha_revision": {
      "type": "string"
    },
    "fuente_id": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "intervalo_pdf_de_referencia": {
      "items": {
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "nivel_evidencia": {
      "enum": [
        0,
        1,
        2,
        3,
        4
      ],
      "type": "integer"
    },
    "paginas_efectivamente_inspeccionadas": {
      "minimum": 0,
      "type": "integer"
    },
    "procedimiento": {
      "enum": [
        "inventario_paginas",
        "revision_visual_focalizada",
        "inventario_visual_miniaturas",
        "extraccion_texto",
        "consulta_de_acceso"
      ]
    },
    "resultado": {
      "type": "string"
    },
    "terminos_buscados": {
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ],
      "uniqueItems": true
    },
    "tipo": {
      "const": "cobertura"
    }
  },
  "required": [
    "alcance",
    "fuente_id",
    "id",
    "nivel_evidencia",
    "paginas_efectivamente_inspeccionadas",
    "procedimiento",
    "resultado",
    "terminos_buscados",
    "tipo"
  ],
  "title": "Cobertura de una fuente",
  "type": "object"
}
